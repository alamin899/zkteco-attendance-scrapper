# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_DRIVER = sqlite (default, local file) | mysql (shared with the dashboard)
DB_DRIVER=sqlite

# SQLite: path to the database file (created automatically)
DB_PATH=attendance.db

# MySQL: either give a full DSN, or the individual parts below.
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/attendance?charset=utf8mb4&parseTime=true&loc=Local
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=attendance
# DB_USERNAME=root
# DB_PASSWORD=

# Create tables if missing (safe/additive). Set false when pointing at a DB
# whose schema is already managed elsewhere (e.g. Laravel migrations).
AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Devices  (only entries with an IP are used; leave one blank for single-device)
# ---------------------------------------------------------------------------
# IN device = outside/entry (a punch here is a CHECK-IN)
ZK_IN_NAME=Outside (Entry)
ZK_IN_IP=192.168.10.201
ZK_IN_PORT=4370

# OUT device = inside/exit (a punch here is a CHECK-OUT)
ZK_OUT_NAME=Inside (Exit)
ZK_OUT_IP=192.168.10.55
ZK_OUT_PORT=4370

# ---------------------------------------------------------------------------
# Device communication
# ---------------------------------------------------------------------------
ZK_TIMEOUT=30          # socket timeout (seconds)
ZK_PASSWORD=0          # device comm key (0 = none)
ZK_RETRIES=2           # extra reconnect attempts on transient read errors
ZK_RETRY_DELAY=2       # base backoff between attempts (seconds)
ZK_STRICT_CHECKSUM=false   # false tolerates the odd malformed packet from flaky units

# ---------------------------------------------------------------------------
# `run` daemon schedule
# ---------------------------------------------------------------------------
POLL_INTERVAL_MINUTES=10   # how often each device is polled
STAGGER_MINUTES=5          # gap between the two devices so device 2 pulls 5 minutes after device 1
